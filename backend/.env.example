# PaperPulse Backend Environment Configuration

# PostgreSQL Database Connection String / URI
DB_URI=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/paperpulse_db

# JWT Authentication Secrets
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE_MIN_32_BYTES
JWT_ISSUER=PaperPulse.API
JWT_AUDIENCE=PaperPulse.Client
JWT_EXPIRATION_MINUTES=10080

# Seed User Passwords (required for initial database seeding)
SEED_ADMIN_EMAIL=admin@paperpulse.com
SEED_ADMIN_PASSWORD=YourSecureAdminPassword!
SEED_TEACHER_PASSWORD=YourSecureTeacherPassword!
SEED_STUDENT_PASSWORD=YourSecureStudentPassword!
